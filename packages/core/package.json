{
  "name": "@theredguild/dcw",
  "version": "0.1.0",
  "description": "AI-native, multi-engine, shell-first container environment wizard",
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dcw": "./bin/run.js",
    "devcontainer-wizard": "./bin/run.js"
  },
  "files": [
    "bin",
    "dist",
    "skill"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "oclif": {
    "bin": "dcw",
    "dirname": "dcw",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "additionalHelpFlags": [
      "-h"
    ],
    "additionalVersionFlags": [
      "-v"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --import tsx bin/dev.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && DCW_E2E=1 vitest run test/e2e",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@oclif/core": "^4.5.2",
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/react": "^18.3.12",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^2.1.8"
  }
}
