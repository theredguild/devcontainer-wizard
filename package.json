{
  "name": "devcontainer-wizard-monorepo",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "build": "pnpm --filter @theredguild/devcontainer-wizard build",
    "test": "pnpm --filter @theredguild/devcontainer-wizard test",
